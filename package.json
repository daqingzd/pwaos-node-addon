{
  "name": "@pwaos.net/runtime-client-api",
  "version": "0.2.10",
  "type": "module",
  "description": "Node.js native addon for the PwaOS RuntimeClient API. Automatically resolves the matching Runtime SDK for your platform.",
  "engines": {
    "node": ">=18"
  },
  "homepage": "https://www.pwaos.net/api",
  "author": {
    "name": "daqingzd",
    "url": "https://github.com/daqingzd"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/daqingzd/pwaos-node-addon.git"
  },
  "license": "MIT",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "files": [
    "runtime.cjs",
    "runtime.js",
    "scripts",
    "src",
    "test",
    "binding.gyp",
    "README.md",
    "LICENSE"
  ],
  "main": "runtime.cjs",
  "exports": {
    ".": {
      "import": "./runtime.js",
      "require": "./runtime.cjs"
    },
    "./package.json": "./package.json"
  },
  "overrides": {
    "tar": "^7.0.0",
    "glob": "^11.0.0"
  },
  "dependencies": {
    "@pwaos.net/runtime": "^0.2.4",
    "node-gyp": "^10.2.0"
  },
  "optionalDependencies": {
    "@pwaos.net/runtime-client-api-linux-x64": "^0.2.1",
    "@pwaos.net/runtime-client-api-win32-x64": "^0.2.1",
    "@pwaos.net/runtime-client-api-win32-x86": "^0.2.1"
  },
  "scripts": {
    "install": "node scripts/install.cjs",
    "build": "node-gyp configure && node-gyp build",
    "build:prebuilt": "node scripts/build-prebuilt-pkg.cjs ./runtime-client-api-linux-x64",
    "test": "node --test test/test.cjs",
    "test:unit": "node --test test/test.cjs"
  },
  "bugs": {
    "url": "https://github.com/daqingzd/pwaos-node-addon/issues"
  },
  "keywords": [
    "pwaos",
    "runtime",
    "client",
    "pwa",
    "webview",
    "webapp",
    "webapplication",
    "browser",
    "napi"
  ],
  "os": [
    "linux",
    "win32"
  ],
  "cpu": [
    "x64",
    "ia32"
  ],
  "gypfile": true
}
